<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Base version; CI overrides with /p:Version (tag or 1.0.0.<run#>). -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenNDOF.Core\OpenNDOF.Core.csproj" />
  </ItemGroup>

  <!--
    The COM host (TDxInput.comhost.dll) needs TDxInput.runtimeconfig.json beside
    it at activation. dotnet publish does not copy a referenced library's
    generated runtimeconfig, so COM activation fails with 0x80008093 ("hostfxr:
    missing runtime config"). Copy it into the publish output explicitly.
  -->
  <Target Name="CopyTdxRuntimeConfig" AfterTargets="Publish">
    <ItemGroup>
      <_TdxRuntimeConfig Include="$(MSBuildThisFileDirectory)..\OpenNDOF.Core\bin\$(Configuration)\**\TDxInput.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_TdxRuntimeConfig)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_TdxRuntimeConfig)' != ''" />
  </Target>


  </Project>
