<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>TDxInput</AssemblyName>
    <RootNamespace>OpenNDOF.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableComHosting>true</EnableComHosting>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The repo does not enforce XML docs on every member; quiet CS1591 noise. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenNDOF.UnitTests" />
    <InternalsVisibleTo Include="OpenNDOF.IntegrationTests" />
    <InternalsVisibleTo Include="OpenNDOF.OtherTests" />
    <InternalsVisibleTo Include="ComCompatProbe" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenNDOF.HID\OpenNDOF.HID.csproj" />
  </ItemGroup>

</Project>
