<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SOLIDWORKS add-in (experimental). SOLIDWORKS hosts add-ins on .NET Framework 4.8,
    so this project cannot reference OpenNDOF.Core / TDxInput (.NET 10) and reads the
    device over raw HID instead.

    Not part of OpenNDOF.slnx / CI: it needs the SOLIDWORKS interop assemblies, which
    ship with SOLIDWORKS. Override their location with
      dotnet build -c Release -p:SolidWorksApiDir="D:\path\to\api\redist"
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OpenNDOF.SolidWorks</AssemblyName>
    <RootNamespace>OpenNDOF.SolidWorks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ComVisible>false</ComVisible>
    <SolidWorksApiDir Condition="'$(SolidWorksApiDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="SpaceMouse.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
